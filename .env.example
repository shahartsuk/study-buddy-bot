# Copy this file to .env and fill in your own values.
# Never commit .env - it contains your bot's secret token.

# Bot token: Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=your-bot-token-here

# Application ID: Developer Portal > your app > General Information
CLIENT_ID=123456789012345678

# ID of your test server: right-click the server > Copy Server ID (needs Developer Mode)
GUILD_ID=123456789012345678
